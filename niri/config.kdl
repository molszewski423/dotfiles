// ── Input ─────────────────────────────────────────────────────────────────────
input {
    keyboard {
        xkb {
            options "caps:escape"
        }
    }

    touchpad {
        tap
        natural-scroll
        dwt
        scroll-method "two-finger"
    }

    focus-follows-mouse
}

// ── Output / Wallpaper ────────────────────────────────────────────────────────
// Wallpaper handled by swaybg in spawn-at-startup below

// ── Layout ────────────────────────────────────────────────────────────────────
layout {
    gaps 6

    focus-ring {
        off
    }

    border {
        width 2
        active-color "#bb9af7"
        inactive-color "#414868"
    }
}

// ── Workspaces ────────────────────────────────────────────────────────────────

// ── Rounded corners ───────────────────────────────────────────────────────────
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

// ── Foot transparency ─────────────────────────────────────────────────────────
window-rule {
    match app-id="foot"
    opacity 0.65
}
window-rule {
    match app-id="foot" is-active=false
    opacity 0.5
}

// ── Floating window rules ─────────────────────────────────────────────────────
window-rule {
    match app-id="wofi"
    open-floating true
}

window-rule {
    match app-id="org.gnome.Calendar"
    open-floating true
}

// ── Autostart ─────────────────────────────────────────────────────────────────
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "gnome-keyring-daemon" "--start" "--components=secrets"
spawn-at-startup "swaybg" "-m" "fill" "-i" "/home/mike/.local/share/backgrounds/2026-05-29-17-20-25-wp4.png"
spawn-at-startup "swayidle" "-w" "timeout" "300" "/home/mike/.config/niri/lock.sh" "timeout" "600" "niri msg action power-off-monitors" "before-sleep" "/home/mike/.config/niri/lock.sh"

// ── Keybindings ───────────────────────────────────────────────────────────────
binds {
    // Apps
    Mod+Return { spawn "foot"; }
    Mod+Shift+F { spawn "nautilus"; }
    Mod+Shift+B { spawn "brave-browser"; }
    Mod+D { spawn "wofi" "--show" "drun" "--prompt" "  Apps"; }

    // Window management
    Mod+Q { close-window; }
    Mod+Shift+C { spawn "niri" "msg" "action" "load-config-file"; }
    Mod+F { fullscreen-window; }
    Mod+Shift+Space { toggle-window-floating; }

    // Focus (vim + arrows)
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }
    Mod+Left { focus-column-left; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+Right { focus-column-right; }

    // Move
    Mod+Shift+H { move-column-left; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Right { move-column-right; }

    // Column width
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // Workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }

    // Screenshots (niri built-in)
    Print { screenshot; }
    Mod+Print { screenshot-screen; }
    Mod+Shift+Print { screenshot-window; }

    // Lock
    Mod+Ctrl+L { spawn "/home/mike/.config/niri/lock.sh"; }

    // Media / hardware keys
    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "-l" "1.5" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp { spawn "brightnessctl" "set" "+10%"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "10%-"; }
}
