# ── Variables ────────────────────────────────────────────────────────────────
set $mod Mod4
floating_modifier $mod normal
set $term /home/mike/.local/kitty.app/bin/kitty -o hide_window_decorations=no
set $files nautilus
set $menu wofi --show drun --prompt "  Apps"
# lock-matrix.sh (swaylock-plugin + mpvpaper, built from source - vanilla swaylock can't
# animate) plays the Tokyo Night purple matrix-rain loop as the lock background, using
# the same color scheme as before.
set $lock ~/.config/sway/scripts/lock-matrix.sh

# ── Display ───────────────────────────────────────────────────────────────────
# Random wallpaper on start/reload (systemd --user timer handles the 30-min rotation)
exec_always ~/.config/sway/scripts/random-wallpaper.sh

# ── Input ─────────────────────────────────────────────────────────────────────
input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt disabled
    scroll_method two_finger
}

input type:keyboard {
    xkb_options caps:escape
}

# ── Window rules ─────────────────────────────────────────────────────────────
for_window [app_id="wofi"] floating enable
for_window [app_id="org.gnome.Calendar"] floating enable, resize set 900 650
for_window [app_id="sway-keybinds"] floating enable, resize set 740 580, move position center
for_window [app_id="wifi-connect"] floating enable, resize set 600 360, move position center
for_window [app_id="org.gnome.Settings"] floating enable, resize set 960 640, move position center

# ── Appearance ────────────────────────────────────────────────────────────────
font pango:JetBrainsMono Nerd Font Mono 11
gaps inner 6
gaps outer -4
default_border pixel 2
default_floating_border pixel 2
smart_gaps on
focus_follows_mouse yes

# Tokyo Night window colors
# class                 border    bg        text      indicator child_border
client.focused          #bb9af7   #24283b   #c0caf5   #bb9af7   #bb9af7
client.focused_inactive #414868   #1f2335   #a9b1d6   #414868   #414868
client.unfocused        #292e42   #1a1b26   #565f89   #292e42   #292e42
client.urgent           #f7768e   #1a1b26   #f7768e   #f7768e   #f7768e
client.placeholder      #1a1b26   #1a1b26   #c0caf5   #1a1b26   #1a1b26

# ── Key Bindings ──────────────────────────────────────────────────────────────
bindsym $mod+Return exec $term
bindsym $mod+Shift+f exec $files
bindsym $mod+Shift+b exec librewolf
bindsym $mod+m exec evolution
bindsym $mod+d exec $menu
bindsym $mod+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning \
    -m 'Exit sway?' -B 'Yes, exit sway' 'swaymsg exit'

# Focus (vim + arrows)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10
bindsym $mod+Prior workspace prev
bindsym $mod+Next workspace next
bindsym $mod+Shift+Prior move container to workspace prev
bindsym $mod+Shift+Next move container to workspace next

# Layout
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# Resize mode
mode "resize" {
    bindsym h resize shrink width 20px
    bindsym j resize grow height 20px
    bindsym k resize shrink height 20px
    bindsym l resize grow width 20px
    bindsym Left resize shrink width 20px
    bindsym Down resize grow height 20px
    bindsym Up resize shrink height 20px
    bindsym Right resize grow width 20px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Screenshots
bindsym Print exec sh -c 'FILE="$HOME/Pictures/Screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png"; grim "$FILE" && wl-copy < "$FILE" && notify-send "Screenshot saved" "$FILE (copied to clipboard)"'
bindsym $mod+Print exec sh -c 'FILE="$HOME/Pictures/Screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png"; grim -g "$(slurp)" "$FILE" && wl-copy < "$FILE" && notify-send "Screenshot saved" "$FILE (copied to clipboard)"'
bindsym $mod+grave exec ~/.config/sway/scripts/screenshot-window.sh
bindsym $mod+Shift+grave exec ~/.config/sway/scripts/screenshot-output.sh
bindsym $mod+Shift+w exec ~/.config/sway/scripts/random-wallpaper.sh

# Screen lock
bindsym $mod+Ctrl+l exec $lock

# Power menu (lock/sleep/restart/shutdown/logout)
bindsym $mod+Shift+p exec /home/mike/.config/waybar/scripts/power-menu.sh

# Media / hardware keys
bindsym XF86AudioRaiseVolume  exec wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+ && pkill -RTMIN+8 waybar
bindsym XF86AudioLowerVolume  exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && pkill -RTMIN+8 waybar
bindsym XF86AudioMute         exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && pkill -RTMIN+8 waybar
bindsym XF86AudioMicMute      exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86MonBrightnessUp   exec brightnessctl set +10%
bindsym XF86MonBrightnessDown exec brightnessctl set 10%-

# ── Autostart ─────────────────────────────────────────────────────────────────
exec_always {
    dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
    systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
    systemctl --user start gsd-rfkill.service polkit-kde-authentication-agent-1.service

    gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark'
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
    gsettings set org.gnome.desktop.interface font-name 'JetBrainsMono Nerd Font Mono 11'
}

exec {
    mako
    gnome-keyring-daemon --start --components=secrets
}

exec_always sh -c 'pkill -x waybar; waybar -c ~/.config/waybar/config-sway.jsonc'
exec_always sh -c 'pkill -x wl-paste; wl-paste --watch cliphist store &'

# Lid switch
# lid:off (opening) uses ensure-display-on.sh, not a plain 'output * power on':
# after a real suspend, swaymsg reports success on the power-on before the kernel's
# DRM subsystem has actually finished resuming, so a single bare call can silently
# no-op and leave the screen black - confirmed 2026-08-22.
bindswitch lid:on  output * power off
bindswitch lid:off exec ~/.config/sway/scripts/ensure-display-on.sh

# Idle: lock after 10min, display off after 30min, lock before sleep
# timeout/screen-off are skipped while a media player (browser video, etc) is Playing via MPRIS
# exec_always + pkill (not plain exec): otherwise editing this line and reloading keeps
# the OLD swayidle process (and its stale lock command) running until logout - bit us on
# MikePC (2026-08-22). Lock script path is inlined directly (not via $lock) to avoid
# nested-quote fragility inside this already-quoted multi-arg exec_always string.
exec_always "pkill -x swayidle; exec swayidle -w timeout 600 '~/.config/sway/scripts/idle-action.sh ~/.config/sway/scripts/lock-matrix.sh' timeout 1800 '~/.config/sway/scripts/idle-action.sh swaymsg \"output * power off\"' resume '~/.config/sway/scripts/ensure-display-on.sh' before-sleep '~/.config/sway/scripts/lock-matrix.sh' after-resume '~/.config/sway/scripts/ensure-display-on.sh'"
