{
    "layer": "top",
    "position": "top",
    "height": 26,
    "margin-top": 1,
    "margin-bottom": 0,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 0,
    "exclusive": true,

    "modules-left": ["custom/debian", "sway/workspaces", "sway/mode"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "bluetooth", "network", "custom/keybinds", "battery", "cpu", "memory", "tray"],

    "custom/debian": {
        "format": "",
        "tooltip": false,
        "on-click": "wofi --show drun --prompt \"  Apps\""
    },

    "sway/workspaces": {
        "disable-scroll": false,
        "all-outputs": false,
        "format": "{name}",
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },

    "sway/mode": {
        "format": "  {}",
        "tooltip": false
    },

    "clock": {
        "format": "󰥔  {:%a %b %d   %I:%M %p}",
        "on-click": "gnome-calendar",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "left",
            "format": {
                "today": "<span color='#7aa2f7'><b>{}</b></span>"
            }
        }
    },

    "cpu": {
        "interval": 3,
        "format": "󰻠 {usage}%",
        "tooltip": false
    },

    "memory": {
        "interval": 10,
        "format": "󰍛 {used:0.1f}G",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },

    "battery": {
        "bat": "BAT0",
        "adapter": "AC",
        "interval": 10,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁽", "󰁿", "󰂁", "󰁹"],
        "tooltip-format": "{timeTo}\n{power}W",
        "on-click": "/home/mike/.config/waybar/scripts/power-menu.sh"
    },

    "custom/keybinds": {
        "format": "󰌌",
        "tooltip": false,
        "on-click": "kitty --class sway-keybinds --title 'Keybindings' -e /home/mike/.config/waybar/scripts/show-keybinds.sh"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱 {num_connections}",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "tooltip-format": "{controller_alias}  {controller_address}",
        "tooltip-format-connected": "{controller_alias}  {controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}  {device_address}",
        "on-click": "blueman-manager"
    },

    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰤭 Offline",
        "format-linked": "󰤫 {ifname}",
        "tooltip-format-wifi": "{signalStrength}%  ·  {ipaddr}\n{frequency}GHz",
        "tooltip-format-ethernet": "{ipaddr}",
        "max-length": 24,
        "on-click": "/home/mike/.config/waybar/scripts/wifi-menu.sh"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "/home/mike/.config/waybar/scripts/volume-menu.sh",
        "scroll-step": 5,
        "tooltip-format": "{desc}"
    },

    "tray": {
        "spacing": 8,
        "icon-size": 16
    }
}
